{
  "rules": {
    "live": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'henrychou911110@gmail.com'",
      ".validate": "newData.hasChildren(['sec','phase'])"
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['r','s'])"
      }
    }
  }
}
