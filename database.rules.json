{
  "rules": {
    "live": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === '102697@medteaching-e190d.web.app' || auth.token.email === '102707@medteaching-e190d.web.app')",
      ".validate": "newData.hasChildren(['sec','phase'])"
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['r','s'])"
      }
    }
  }
}
